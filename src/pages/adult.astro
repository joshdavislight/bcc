---
import Base from '../layouts/Base.astro';
---

<Base
  title="Adult Classes"
  description="Adult circus classes at Boulder Circus Center: aerial, juggling, open gym, and workshops. Browse the live schedule and register online."
>
  <section class="section">
    <div class="container">
      <h1>Adult classes</h1>
      <p class="lead">
        Aerial arts, juggling, open gym, and workshops for adults of all levels.
      </p>
      <p>
        This is the same schedule the FitDegree app shows. Pick a class to register.
      </p>

      <div class="schedule">
        <div id="fd-live-schedule-widget" data-fitspot-id="325"></div>
        <noscript>
          <p>
            <a href="https://app.fitdegree.com/t/dashboard?co=305&amp;f=325">View the adult class schedule on FitDegree</a>.
          </p>
        </noscript>
      </div>

      <p class="note">
        Registering creates a free FitDegree account. You can also open the
        <a href="https://app.fitdegree.com/t/dashboard?co=305&amp;f=325">FitDegree student portal</a> directly.
      </p>
      <p class="note">
        Questions? Email <a href="mailto:classes@bouldercircuscenter.net">classes@bouldercircuscenter.net</a>.
      </p>
    </div>
  </section>

  <script is:inline src="https://support.fitdegree.com/widget/fd-widget.min.js"></script>
</Base>

<style>
  .schedule {
    margin-block: var(--space-xl) var(--space-lg);
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-block-end: var(--space-sm);
  }
</style>
