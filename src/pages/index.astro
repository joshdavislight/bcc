---
import Base from '../layouts/Base.astro';
import rooms from '../data/rooms.json';

const localBusiness = {
  '@type': 'LocalBusiness',
  name: 'Boulder Circus Center',
  description: 'A place for circus in Boulder — classes, workshops, and rental space for circus artists.',
  url: 'https://bouldercircuscenter.net',
  telephone: '+1-303-444-8110',
  email: 'bouldercircuscenter@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4747 26th St',
    addressLocality: 'Boulder',
    addressRegion: 'CO',
    postalCode: '80301',
    addressCountry: 'US',
  },
};

const facilityRooms = rooms.filter((r) =>
  ['rastelli-theatre', 'rastelli-aerial', 'trixie'].includes(r.id)
);
---

<Base
  title="Boulder Circus Center"
  description="A place for circus in Boulder. Youth and adult classes, workshops, and rental space for circus artists."
  jsonLd={localBusiness}
>
  <section class="hero js-spotlight" aria-label="Introduction">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__spotlight" aria-hidden="true"></div>
    <div class="hero__content container">
      <p class="hero__eyebrow">Boulder, Colorado · Est. 2004</p>
      <h1 class="hero__title display">A place for circus</h1>
      <p class="hero__lead">
        10,000 square feet of training space for aerial, acrobatics, juggling, and circus theater.
        Classes for youth and adults, workshops with world-class teachers, and studio rental in North Boulder.
      </p>
      <div class="hero__actions">
        <a class="btn btn--ghost" href="/youth/">Explore classes</a>
        <a class="btn btn--ghost" href="/facilities/">Book a room</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="classes-heading">
    <div class="container">
      <span class="label">Programs</span>
      <h2 id="classes-heading" class="display section__title">Classes for every age</h2>
      <p class="lead section__intro">
        Session-based classes and drop-in options led by professional circus artists. Beginners are welcome — no experience required.
      </p>
      <ul class="grid grid--2 cards">
        <li class="card">
          <div class="card__media">
            <img src="/images/youth-trapeze.webp" alt="Youth student on trapeze" width="600" height="450" loading="lazy" />
          </div>
          <div class="card__content">
            <p class="card__meta">Ages 6–17</p>
            <h3 class="display card__title">Youth Circus</h3>
            <p class="card__description">Mixed circus sessions, aerial arts, and the Teen Cirque Theater Lab. Small classes, expert coaches, and a fun, safe place to build confidence.</p>
            <a class="btn" href="/youth/">View youth classes</a>
          </div>
        </li>
        <li class="card">
          <div class="card__media">
            <img src="/images/adult-acro.webp" alt="Adult acro class in session" width="600" height="385" loading="lazy" />
          </div>
          <div class="card__content">
            <p class="card__meta">Ages 16+</p>
            <h3 class="display card__title">Adult Classes</h3>
            <p class="card__description">Aerial fabric, sling, trapeze, lyra, handstands, acro, and open workouts. Drop in or commit to a session — all levels from beginner to professional.</p>
            <a class="btn" href="/adult/">View adult classes</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--purple" aria-labelledby="facilities-heading">
    <div class="container">
      <div class="grid grid--2 facilities">
        <div>
          <span class="label">Facilities</span>
          <h2 id="facilities-heading" class="display section__title">Room to take flight</h2>
          <p class="facilities__lead">
            Three studios under one roof, plus community spaces, a green room, and five acres of grounds with a view of the foothills.
          </p>
          <ul class="facilities__list">
            {facilityRooms.map((room) => (
              <li>
                <strong class="facilities__name">{room.name}</strong>
                <span class="facilities__specs">{room.dimensions} · {room.ceiling} ceiling</span>
              </li>
            ))}
          </ul>
          <a class="btn btn--ghost" href="/facilities/">See facilities & pricing</a>
        </div>
        <div class="facilities__media">
          <img src="/images/facilities-outside.webp" alt="Boulder Circus Center building exterior" width="800" height="534" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="coming-up-heading">
    <div class="container">
      <span class="label">Today</span>
      <h2 id="coming-up-heading" class="display section__title">What’s on today</h2>
      <div id="fd-live-schedule-today-widget" data-fitspot-id="325"></div>
      <p class="today-note">
        Looking further ahead? <a href="/adult/">See the full class schedule</a>.
      </p>
    </div>
  </section>
  <script is:inline src="https://support.fitdegree.com/widget/fd-widget.min.js"></script>

  <section class="section section--cream">
    <div class="container text-center">
      <h2 class="display section__title">Visit us</h2>
      <p class="lead">
        <strong>Boulder Circus Center</strong><br />
        4747 26th St, Boulder, CO 80301<br />
        <a href="tel:+13034448110">(303) 444-8110</a>
      </p>
      <a class="btn" href="/contact/">Plan your first visit</a>
    </div>
  </section>
</Base>

<script>
  import gsap from 'gsap';

  (function initSpotlight() {
    const hero = document.querySelector('.js-spotlight') as HTMLElement | null;
    if (!hero) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    if (prefersReducedMotion || isTouch) return;

    let targetX = 50;
    let targetY = 50;
    let currentX = 50;
    let currentY = 50;

    hero.addEventListener('mousemove', (event: MouseEvent) => {
      const rect = hero.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width) * 100;
      targetY = ((event.clientY - rect.top) / rect.height) * 100;
    });

    hero.addEventListener('mouseleave', () => {
      targetX = 50;
      targetY = 50;
    });

    gsap.ticker.add(() => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      hero.style.setProperty('--x', `${currentX}%`);
      hero.style.setProperty('--y', `${currentY}%`);
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 80vh;
    padding-block: var(--space-3xl);
    overflow: hidden;
    text-align: center;
    color: var(--bcc-white);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-facilities.webp');
    background-size: cover;
    background-position: center;
  }

  .hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--bcc-overlay);
  }

  .hero__spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      circle min(34vw, 360px) at var(--x, 50%) var(--y, 50%),
      rgba(48, 42, 129, 0) 0%,
      rgba(48, 42, 129, 0) 18%,
      rgba(31, 26, 85, 0.55) 55%,
      rgba(31, 26, 85, 0.92) 100%
    );
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hero__spotlight {
      display: none;
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }

  .hero__eyebrow {
    margin-block-end: var(--space-md);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero__title {
    font-size: var(--font-size-2xl);
    line-height: 1;
    color: var(--bcc-white);
    margin-block-end: var(--space-lg);
  }

  .hero__lead {
    max-width: 60ch;
    margin-inline: auto;
    margin-block-end: var(--space-xl);
    font-size: var(--font-size-md);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  .section__title {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-md);
  }

  .section__intro {
    max-width: 60ch;
    margin-block-end: var(--space-xl);
  }

  .cards {
    list-style: none;
  }

  .card__meta {
    margin-block-end: var(--space-sm);
    font-size: var(--font-size-xs);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .card__title {
    font-size: var(--font-size-lg);
    line-height: 1.1;
  }

  .section--purple .section__title,
  .section--purple .facilities__lead {
    color: var(--bcc-white);
  }

  .facilities__lead {
    margin-block-end: var(--space-lg);
    color: rgba(255, 255, 255, 0.9);
  }

  .facilities__list {
    list-style: none;
    display: grid;
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .facilities__list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .facilities__name {
    font-size: var(--font-size-base);
    color: var(--bcc-white);
  }

  .facilities__specs {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.75);
  }

  .facilities__media {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .facilities__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #fd-live-schedule-today-widget {
    margin-block-start: var(--space-lg);
    min-height: 12rem;
  }

  .today-note {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
