---
import Base from '../layouts/Base.astro';
import rooms from '../data/rooms.json';

const rate = (id: string) => rooms.find((room) => room.id === id)?.rate ?? '';

const localBusiness = {
  '@type': 'LocalBusiness',
  name: 'Boulder Circus Center',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4747 26th St',
    addressLocality: 'Boulder',
    addressRegion: 'CO',
    postalCode: '80301',
    addressCountry: 'US',
  },
};
---

<Base
  title="Facilities & Rentals"
  description="Rent studio space at Boulder Circus Center. 10,000 sq ft with sprung floors, rig points, theatrical lighting, and more."
  jsonLd={localBusiness}
>
  <section class="section">
    <div class="container">
      <h1>The Boulder Circus Center Facilities</h1>
      <p class="lead">
        The Boulder Circus Center is a 10,000 sq ft training space in North Boulder. It has three studios, plus community spaces and technical areas.
      </p>
      <nav aria-label="Facility sections" class="toc">
        <a href="#rastelli">The Rastelli Room</a>
        <a href="#trixie">The Trixie Room</a>
        <a href="#workshop">The Workshop</a>
        <a href="#amenities">Amenities</a>
        <a href="#requirements">Requirements</a>
        <a href="#rates">Rental policies</a>
      </nav>
    </div>
  </section>

  <section class="section section--purple" id="rastelli">
    <div class="container">
      <h2 class="display">The Rastelli Room</h2>
      <p class="rate">{rate('rastelli-full')}</p>
      <p>
        The Rastelli room is the largest studio at the BCC. The floor is sprung oak with Harlequin specs, and the lights point upward. Natural light and fresh air are plentiful. The room can be divided into two areas that rent separately.
      </p>
      <div class="feature-media feature-media--inline">
        <img src="/images/facilities-rastelli.webp" alt="The Rastelli Room stage, with aerial silks rigged above a sprung oak floor and black and red curtains" width="1100" height="734" loading="lazy" />
      </div>
      <div class="grid grid--2">
        <div class="feature-block">
          <h3>The Theatre Side</h3>
          <p class="rate">{rate('rastelli-theatre')}</p>
          <p>Designed to be a theatre rehearsal space.</p>
          <ul>
            <li>Dimensions: 35′ × 60′ wide, 18′ 6″ high</li>
            <li>I-Beams: 8 steel I-beams each 34 feet long where hang-points can be located. Steel I-beams run front to back in the theatre area and are spaced 8′ on center.</li>
            <li>Other: A black Marley floor is available for this area; special fees and advance arrangements apply.</li>
          </ul>
        </div>
        <div class="feature-block">
          <h3>The Aerial Corridor</h3>
          <p class="rate">{rate('rastelli-aerial')}</p>
          <p>Designed for aerial arts and acrobatics.</p>
          <ul>
            <li>Dimensions: 25′ × 60′ wide, sloping ceiling up to 27 feet high</li>
            <li>I-Beams: five steel I-beams for hang points: one center beam at 26′ 2″ (requires beam clamps), two beams on either side at 23′ 2″, and two outside beams at 20′ 6″</li>
            <li>Other: mirrored wall, 40′ wide by 9′ high</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="trixie">
    <div class="container">
      <div class="grid grid--2 feature-row">
        <div>
          <h2 class="display">The Trixie Room</h2>
          <p class="rate">{rate('trixie')}</p>
          <p>
            The Trixie room is the medium-sized studio upstairs. It has a sprung oak floor, ample lighting, and more intimate lighting options, plus natural light and fresh air. It suits small rehearsals, dance classes, and private aerial lessons.
          </p>
          <ul>
            <li>Dimensions: 25′ × 31′ wide, 14′ – 16′ high</li>
            <li>14 aerial points (7 at 14′, 7 at 16′)</li>
            <li>Mirrors cover half of one of the walls</li>
            <li>A black Marley floor is available for this area; special fees and advance arrangements apply</li>
          </ul>
        </div>
        <div class="feature-media">
          <img src="/images/facilities-trixie.webp" alt="The Trixie Room, an upstairs studio with a sprung oak floor, high white ceiling, and a white curtain across one wall" width="1200" height="900" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="workshop">
    <div class="container">
      <div class="grid grid--2 feature-row">
        <div>
          <h2 class="display">The Workshop</h2>
          <p class="rate">{rate('workshop')}</p>
          <p>
            The Workshop is the newest and smallest room at the BCC. It has a sprung oak floor with ample lighting, a stereo system, and a 12 foot ceiling. It suits small classes and one-on-one workshops.
          </p>
        </div>
        <div class="feature-media">
          <img src="/images/facilities-workshop.webp" alt="The Workshop studio at Boulder Circus Center" width="800" height="534" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="amenities">
    <div class="container">
      <h2 class="display">Amenities</h2>
      <p class="section__intro">
        Community spaces and technical areas available to renters, teachers, and members.
      </p>
      <div class="amenities">
        <article class="amenity" id="light-booth">
          <div class="amenity__media">
            <img src="/images/facilities-light-booth.webp" alt="The ETC 48/96 lighting console in the Boulder Circus Center light booth" width="1200" height="749" loading="lazy" />
          </div>
          <h3>Light Booth</h3>
          <p>Overlooks the Rastelli Room on the Aerial Corridor side. Available for rental.</p>
          <ul>
            <li>ETC 48/96 light board, 48 dimming channels rated for 2K each</li>
            <li>12 cyc lights in 4 sets of 3 colors, 1000 watts</li>
            <li>8 par 64 lights as high sides, 1000 watt</li>
            <li>24 fresnels as overhead wash, 750 watt</li>
            <li>18 lekos as front of house wash, 1000 watt</li>
          </ul>
        </article>

        <article class="amenity" id="green-room">
          <div class="amenity__media">
            <img src="/images/facilities-green-room.webp" alt="The Green Room community space with couches, a piano, and a coffee station" width="800" height="498" loading="lazy" />
          </div>
          <h3>Green Room</h3>
          <p>A community space upstairs to use between classes and rehearsals.</p>
          <ul>
            <li>Coffee and espresso machines</li>
            <li>Small refrigerator</li>
            <li>Ample seating</li>
            <li>Desk and table space</li>
            <li>Free wifi</li>
          </ul>
        </article>

        <article class="amenity" id="garage">
          <div class="amenity__media">
            <img src="/images/facilities-garage.webp" alt="The Garage storage area with floor-to-ceiling shelving, unicycles, and German wheels" width="800" height="600" loading="lazy" />
          </div>
          <h3>The Garage</h3>
          <p>A multi-purpose storage area at the BCC.</p>
          <ul>
            <li>20 foot ceilings</li>
            <li>Floor to ceiling garage door</li>
            <li>Lots of shelving space</li>
            <li>Message us if you want to store gear here</li>
          </ul>
        </article>

        <article class="amenity" id="grounds">
          <div class="amenity__media">
            <img src="/images/facilities-grounds.webp" alt="The patio and deck at the Boulder Circus Center with picnic tables" width="800" height="448" loading="lazy" />
          </div>
          <h3>The Grounds</h3>
          <p>A five-acre parcel with a great western view of the foothills and beyond.</p>
          <ul>
            <li>Community garden</li>
            <li>Yoga deck</li>
            <li>Picnic tables</li>
            <li>Large parking lot</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="requirements">
    <div class="container">
      <h2>Facility Use Requirements</h2>
      <p>
        If you are a teacher or company wishing to hold classes in a studio, the following requirements apply:
      </p>
      <ul>
        <li>
          <strong>FIRST AID:</strong> Any teacher must have a current first aid certification. Any additional or substitute teacher for the primary company/renter must also be first aid certified and must be on record at the BCC as a teacher for the company.
        </li>
        <li>
          <strong>INSURANCE:</strong> Any individual, teacher, company, or legal entity planning to teach or rehearse any activity where anyone’s (student or teacher) feet leave the ground through mechanical means (unicycle, stilts, rolling-globe, trampoline, rolla-bolla, aerial apparatus of all kinds), needs to have a liability insurance policy naming “Boulder Circus Center LLC” as also insured.
        </li>
      </ul>
      <p>If you are an individual wishing to rehearse in a studio:</p>
      <ul>
        <li>
          An individual or small group (but not a teacher or a company) wishing to rehearse activities where their feet leave the ground through mechanical means must have a BCC trainer knowledgeable in the field present for spotting, safety and insurance reasons.
        </li>
        <li>
          If you are an individual and you wish to teach activities where a student’s feet leave the ground through mechanical means, then you must have your own liability insurance naming Boulder Circus Center LLC as also insured.
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="rates">
    <div class="container">
      <h2>Rental policies</h2>
      <p>All rates are hourly and double for groups over 40 people.</p>
      <p>
        If you have questions about the rental/insurance policy, please feel free to contact the <a href="/contact/">building managers</a> for more details.
      </p>
      <p>
        <strong>Cancellation policy:</strong> full refund minus a $5 cancellation fee for cancellations more than 14 days out;
        50% refund within 14 days; up to 10 refunded cancellations per year; reservations may be transferred to another registered user.
      </p>
      <p id="book" class="book">
        <a class="btn" href="https://bcc.skedda.com/booking" target="_blank" rel="noopener">Book a room</a>
      </p>
    </div>
  </section>

  <section class="section section--cream" id="calendar">
    <div class="container">
      <h2>Renter's calendar</h2>
      <p>
        Bookings run through Skedda. Pick a room, choose your hours, and pay there.
      </p>
      <div class="allbooked-embed">
        <iframe
          src="https://bcc.skedda.com/booking?embedded=true"
          title="Boulder Circus Center booking calendar"
          loading="lazy"
          style="width:100%;height:1000px;border:0;"
        ></iframe>
      </div>
      <p class="note">
        Calendar not loading? <a href="https://bcc.skedda.com/booking" target="_blank" rel="noopener">Open it in Skedda</a>.
      </p>
      <p class="note">
        Need to change or cancel a booking, or ask about a rate? <a href="/contact/">Contact the building managers</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-xl);
  }

  .toc a {
    font-weight: 700;
    text-decoration: none;
  }

  .rate {
    font-size: var(--font-size-md);
    color: var(--color-accent);
    font-weight: 700;
    margin-block: 0 var(--space-sm);
  }

  .feature-block .rate {
    color: var(--bcc-white);
  }

  .section--purple .rate {
    color: var(--bcc-white);
  }

  .feature-block {
    padding: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .feature-block h3 {
    color: var(--bcc-white);
    margin-block-start: 0;
  }

  .feature-block ul,
  .feature-block p {
    color: rgba(255, 255, 255, 0.9);
  }

  .feature-row {
    align-items: start;
  }

  .feature-media {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feature-media img {
    width: 100%;
    height: auto;
  }

  .feature-media--inline {
    margin-block: var(--space-lg);
  }

  .amenities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
  }

  .amenity {
    display: flex;
    flex-direction: column;
    background-color: var(--color-paper);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .amenity__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .amenity__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .amenity h3 {
    font-size: var(--font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: var(--space-md) var(--space-md) var(--space-sm);
  }

  .amenity p,
  .amenity ul {
    margin-inline: var(--space-md);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .amenity p {
    color: var(--color-text-muted);
    margin-block: 0 var(--space-sm);
  }

  .amenity ul {
    margin-block: 0 var(--space-md);
    padding-inline-start: 1.1em;
  }

  .book {
    margin-block: var(--space-lg) 0;
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-block-end: 0;
  }

  .allbooked-embed {
    margin-block: var(--space-lg);
  }

  .allbooked-embed iframe {
    display: block;
    border-radius: var(--radius);
    background-color: var(--color-paper);
  }
</style>
